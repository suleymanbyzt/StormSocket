<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StormSocket.Extensions.Hosting</RootNamespace>
    <AssemblyName>StormSocket.Extensions.Hosting</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591;CS1573</NoWarn>

    <!-- NuGet Package -->
    <PackageId>StormSocket.Extensions.Hosting</PackageId>
    <Version>5.2.0</Version>
    <Authors>suleymanbyzt</Authors>
    <Description>Dependency injection and Generic Host integration for StormSocket: AddStormWebSocketServer, handler abstractions resolved from DI, hosted service lifecycle with graceful drain, and health checks.</Description>
    <PackageTags>tcp;websocket;server;dependency-injection;hosting;aspnetcore;healthchecks;stormsocket</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>stormsocket-icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/suleymanbyzt/StormSocket</PackageProjectUrl>
    <RepositoryUrl>https://github.com/suleymanbyzt/StormSocket</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\assets\stormsocket-icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StormSocket\StormSocket.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StormSocket.Tests" />
  </ItemGroup>

</Project>
